{
  "name": "devote",
  "version": "0.0.0",
  "private": true,
  "description": "DeVote — a decentralized voting dApp on the Aptos blockchain.",
  "license": "MIT",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @devote/web dev",
    "build": "pnpm --filter @devote/web build",
    "preview": "pnpm --filter @devote/web preview",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "move:compile": "pnpm --filter @devote/move-contract compile",
    "move:test": "pnpm --filter @devote/move-contract test",
    "prepare": "husky"
  }
}
