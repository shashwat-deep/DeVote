# ─────────────────────────────────────────────────────────────
# DeVote web client environment
# Copy to `.env.local` and fill in. All vars are build-time (VITE_*).
# ─────────────────────────────────────────────────────────────

# Aptos network: testnet | devnet | mainnet | local
VITE_APTOS_NETWORK=testnet

# Address the DeVote Move module is published under (0x...).
# Obtain after `pnpm move:compile && aptos move publish`.
VITE_MODULE_ADDRESS=

# Optional endpoint overrides (blank = use network defaults)
VITE_APTOS_FULLNODE_URL=
VITE_APTOS_INDEXER_URL=

# Optional Sentry DSN for error telemetry (blank = disabled)
VITE_SENTRY_DSN=
